{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adjie-workspace-ask",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "ai": { "binding": "AI" },
  "vars": {
    "ALLOWED_ORIGINS": "https://adjierizqan.github.io,http://localhost:3000,http://localhost:4174"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "11001",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
